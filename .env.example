# Django Core
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-mfdfs-2026
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local

# Copernicus Data Space (https://dataspace.copernicus.eu)
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASS=your_copernicus_password

# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ohsome API v2 (https://api.heigit.org/ohsome-api/v2-rc/docs) - Optional, falls back gracefully if unset
OHSOME_API_KEY=your_ohsome_v2_api_key_here

# CartoDB Basemaps API (https://carto.com/basemaps/apikey) - Optional
CARTO_API_KEY=your_carto_api_key_here

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media and Data Paths
MEDIA_ROOT=/mnt/Personal/Projects/Mfdfs/media
DATA_DIR=/mnt/Personal/Projects/Mfdfs/data
