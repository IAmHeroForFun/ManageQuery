# ==============================================================================
# Production Environment Variables for Mfdfs on AWS Lightsail
# Copy this file to .env on your Lightsail server:
# cp .env.production.example .env
# ==============================================================================

# --- Django Security ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here-min-50-characters

# Hosts allowed to access Django (your Lightsail public IP and domain)
DJANGO_ALLOWED_HOSTS=flood.omvihub.in,127.0.0.1,localhost

# CSRF Trusted Origins (needed for POST requests behind HTTPS reverse proxy)
CSRF_TRUSTED_ORIGINS=https://flood.omvihub.in,https://*.omvihub.in

# --- PostgreSQL Database ---
POSTGRES_DB=mfdfs_db
POSTGRES_USER=mfdfs_user
POSTGRES_PASSWORD=choose_a_secure_postgres_password_here

# --- Google Gemini AI (Required for Disaster Briefings & Copilot Q&A) ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Copernicus Data Space Ecosystem (Required for live Sentinel-1 & 2 retrieval) ---
# Obtain from: https://dataspace.copernicus.eu
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASS=your_copernicus_password

# --- OpenStreetMap / Basemaps (Optional) ---
OHSOME_API_KEY=
CARTO_API_KEY=
